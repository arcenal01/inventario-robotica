# =====================================================================
# Inventário Robótica: variáveis de ambiente
# Copie este arquivo para ".env.local" (desenvolvimento) e preencha.
# NUNCA commite arquivos .env com valores reais.
# Para migrar para a nuvem, só estas variáveis mudam.
# =====================================================================

# URL do Supabase.
# Local, só neste computador:     http://127.0.0.1:54321
# Testando pelo celular na rede:  http://IP-DO-COMPUTADOR:54321  (ver docs/06-ambiente-local.md)
# Nuvem (futuro):                 https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Chave pública ("anon key" ou "Publishable key"): aparece em `npm run db:status`.
# Pode ficar no frontend (a segurança vem do RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-publica

# Endereço do app (usado em links e QR Codes)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Só para desenvolvimento pelo celular: IP do computador (o mesmo usado acima).
# Sem isso, o Next.js bloqueia o acesso de outros aparelhos ao "npm run dev". Pode deixar em branco.
DEV_ORIGINS=

# ---------------------------------------------------------------------
# Só para scripts de servidor (NUNCA use no frontend, NUNCA com prefixo NEXT_PUBLIC_).
# Hoje o sistema não precisa dela. Deixe em branco.
# ---------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
