# =====================================================================
# Inventário Robótica: variáveis de ambiente
# Copie este arquivo para ".env.local" (desenvolvimento) e preencha.
# NUNCA commite arquivos .env com valores reais.
# Para migrar para a nuvem, só estas variáveis mudam.
# =====================================================================

# URL do Supabase vista pelo navegador.
# Recomendado (Bloco 14): /supabase  -> o navegador fala só com o app, que repassa ao Supabase.
#   Funciona no PC, no celular pela rede e pelo túnel https, sem abrir a porta 54321.
#   Exige SUPABASE_URL_INTERNO logo abaixo.
# Direto (antigo):  http://127.0.0.1:54321
# Nuvem / Netlify:  https://SEU-PROJETO.supabase.co   (aí SUPABASE_URL_INTERNO fica em branco)
#   Na Netlify estas variáveis são cadastradas no painel do site, não em arquivo. Veja docs/17-netlify.md.
#   Elas são gravadas dentro do app na hora do build: se mudar, faça um novo deploy.
NEXT_PUBLIC_SUPABASE_URL=/supabase

# Onde o SERVIDOR do app encontra o Supabase (só usado com NEXT_PUBLIC_SUPABASE_URL=/supabase).
SUPABASE_URL_INTERNO=http://127.0.0.1:54321

# Chave pública ("anon key" ou "Publishable key"): aparece em `npm run db:status`.
# Na nuvem: Supabase > Project Settings > API (a "anon" ou "publishable", NUNCA a "service_role").
# Pode ficar no frontend (a segurança vem do RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-publica

# Endereço do app (usado em links e QR Codes)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Só para desenvolvimento pelo celular: IP do computador (o mesmo usado acima).
# Sem isso, o Next.js bloqueia o acesso de outros aparelhos ao "npm run dev". Pode deixar em branco.
DEV_ORIGINS=

# ---------------------------------------------------------------------
# Só para scripts de servidor (NUNCA use no frontend, NUNCA com prefixo NEXT_PUBLIC_).
# Hoje o sistema não precisa dela. Deixe em branco.
# ---------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
